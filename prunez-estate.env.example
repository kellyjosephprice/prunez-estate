# Template for prunez-estate.env. Copy to prunez-estate.env on the deploy
# machine and fill in real values (the real file is gitignored).
#
#   cp prunez-estate.env.example prunez-estate.env

# --- Web admin ---
# Password for the Pi-hole web UI.
FTLCONF_webserver_api_password=CHANGE_ME

# --- DHCP server ---
# Pi-hole serves DHCP for the LAN. Adjust the range/router to your subnet.
FTLCONF_dhcp_active=true
FTLCONF_dhcp_start=192.168.1.100
FTLCONF_dhcp_end=192.168.1.250
FTLCONF_dhcp_router=192.168.1.254
FTLCONF_dhcp_leaseTime=24h
# Hand out IPv6 (RA/SLAAC) too — uncomment if you want it.
#FTLCONF_dhcp_ipv6=true
